{{- $instanceName := env "INSTANCE_NAME" -}}
{{- $baseDomain := env "BASE_DOMAIN" -}}
serverAddr = "{{ env "FRP_SERVER_ADDR" }}"
serverPort = {{ env "FRP_SERVER_PORT" }}

auth.method = "token"
auth.token = "{{ env "FRP_TOKEN" }}"

webServer.addr = "127.0.0.1"
webServer.port = 7400
{{ range $container := . -}}
{{- $rawName := trimPrefix "/" $container.Name -}}
{{- $containerName := replace (replace (toLower $rawName) "/" "-" -1) "_" "-" -1 -}}
{{- $stackRaw := index $container.Labels "com.docker.compose.project" -}}
{{- $stackName := replace (toLower $stackRaw) "_" "-" -1 -}}
{{- $ip := "" -}}
{{- range $net := $container.Networks -}}
{{- if not $ip -}}{{- $ip = $net.IP -}}{{- end -}}
{{- end -}}
{{- range $addr := $container.Addresses -}}
{{- if and $addr.HostPort (eq $addr.Proto "tcp") -}}
{{- if $stackName }}
[[proxies]]
name = "{{ $instanceName }}-{{ $stackName }}-{{ $containerName }}-port{{ $addr.HostPort }}"
type = "http"
localIP = "{{ $ip }}"
localPort = {{ $addr.Port }}
customDomains = ["{{ $instanceName }}-{{ $stackName }}-{{ $containerName }}-port{{ $addr.HostPort }}.{{ $baseDomain }}"]
{{ else }}
[[proxies]]
name = "{{ $instanceName }}-{{ $containerName }}-port{{ $addr.HostPort }}"
type = "http"
localIP = "{{ $ip }}"
localPort = {{ $addr.Port }}
customDomains = ["{{ $instanceName }}-{{ $containerName }}-port{{ $addr.HostPort }}.{{ $baseDomain }}"]
{{ end -}}
{{- end -}}
{{- end -}}
{{- end }}
