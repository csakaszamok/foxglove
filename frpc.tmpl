{{- $instanceName := env "INSTANCE_NAME" -}}
{{- $baseDomain := env "BASE_DOMAIN" -}}
serverAddr = "{{ env "FRP_SERVER_ADDR" }}"
serverPort = {{ env "FRP_SERVER_PORT" }}

auth.method = "token"
auth.token = "{{ env "FRP_TOKEN" }}"

webServer.addr = "127.0.0.1"
webServer.port = 7400

# Readiness marker: present once docker-gen's config is applied, even when no
# container publishes a port. stcp with a per-start random secret, so it is
# never reachable and never listed among the HTTP proxies.
[[proxies]]
name = "{{ $instanceName }}.ready"
type = "stcp"
secretKey = "{{ env "FRPC_READY_SECRET" }}"
localIP = "127.0.0.1"
localPort = 1

{{ range $container := . -}}
{{- $rawName := trimPrefix "/" $container.Name -}}
{{- $containerName := replace (replace (toLower $rawName) "/" "-" -1) "_" "-" -1 -}}
{{- $stackRaw := index $container.Labels "com.docker.compose.project" -}}
{{- $stackName := replace (toLower $stackRaw) "_" "-" -1 -}}
{{- $ip := "" -}}
{{- range $net := $container.Networks -}}
{{- if not $ip -}}{{- $ip = $net.IP -}}{{- end -}}
{{- end -}}
{{- $subdomain := index $container.Labels "frpc.subdomain" -}}
{{- range $addr := $container.Addresses -}}
{{- /* Only ports published on all interfaces get a proxy; one published on
       loopback (127.0.0.0/8, ::1) is private to the sandbox. */ -}}
{{- $public := or (eq $addr.HostIP "") (eq $addr.HostIP "0.0.0.0") (eq $addr.HostIP "::") -}}
{{- if and $addr.HostPort (eq $addr.Proto "tcp") $public -}}
{{- if $subdomain }}
[[proxies]]
name = "{{ $instanceName }}-{{ $subdomain }}"
type = "http"
localIP = "{{ $ip }}"
localPort = {{ $addr.Port }}
customDomains = ["{{ $instanceName }}-{{ $subdomain }}.{{ $baseDomain }}"]
{{- else if $stackName }}
[[proxies]]
name = "{{ $instanceName }}-{{ $stackName }}-{{ $containerName }}-port{{ $addr.HostPort }}"
type = "http"
localIP = "{{ $ip }}"
localPort = {{ $addr.Port }}
customDomains = ["{{ $instanceName }}-{{ $stackName }}-{{ $containerName }}-port{{ $addr.HostPort }}.{{ $baseDomain }}"]
{{ else }}
[[proxies]]
name = "{{ $instanceName }}-{{ $containerName }}-port{{ $addr.HostPort }}"
type = "http"
localIP = "{{ $ip }}"
localPort = {{ $addr.Port }}
customDomains = ["{{ $instanceName }}-{{ $containerName }}-port{{ $addr.HostPort }}.{{ $baseDomain }}"]
{{ end -}}
{{- end -}}
{{- end -}}
{{- end }}
